# *************************************************************************
# AXI Switch (1 slave, 2 masters) - AXI4 Full, 64-bit address
#
# Wrapped by axi_dma_switch_wrapper.sv and instantiated as
# axi_dma_switch_inst in alveo_u50_static.sv. Splits the XDMA DMA path
# (axi_dma) between HBM and HBICAP by address.  The DMA→RM path that
# this switch used to expose has been removed — the dynamic region
# does its own HBM access without needing an XDMA-driven AXI4 slave.
#
# Host-DMA address map:
#   M00 0x0000000000000000 - 0x00000001FFFFFFFF   HBM (8 GB, 512-bit) —
#                                                  feeds axi_hbm_switch.S00,
#                                                  then HBM port 00.  All 8 GB
#                                                  of U50 HBM are reachable
#                                                  here via the HBM IP's
#                                                  internal port-to-port
#                                                  switch.
#   M01 0x0000000200000000 - 0x000000020000FFFF   HBICAP (64 KB, 32-bit
#                                                  data) — feeds
#                                                  axi_hbicap_0.s_axi for
#                                                  high-bandwidth bitstream
#                                                  streaming.  The switch
#                                                  converts 512-bit slave
#                                                  writes into a stream of
#                                                  32-bit writes at M01.
#                                                  HBICAP's AXI-Lite control
#                                                  side is reached separately
#                                                  through the BAR at
#                                                  0x0037_0000.
#
# Reserved hole: 0x0000000200010000 onwards is unmapped (no third master
# any more); host software should keep DMA transactions inside the two
# windows above.
#
# The switch uses a single S00_AXI_ID_WIDTH = 4 for all ports, so M01's
# outgoing awid/arid are 4 bits wide.  HBICAP's s_axi_awid is 1 bit — the
# static module forces HBICAP's awid/arid to 0 and zero-returns M01's
# bid/rid, which is safe because XDMA's bitstream DMA uses a single ID
# anyway.
#
# Source IP : xilinx.com:ip:axi_switch:1.0
# *************************************************************************

create_ip -name axi_switch \
          -vendor xilinx.com \
          -library ip \
          -version 1.0 \
          -module_name axi_dma_switch

set_ip_properties_safe axi_dma_switch [list \
